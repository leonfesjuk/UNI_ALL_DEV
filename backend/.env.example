# Database Configuration
# ⚠️ NEVER commit real credentials to git

# MySQL (ERP source database)
DB_MYSQL_HOST=your_mysql_host_here
DB_MYSQL_PORT=3306
DB_MYSQL_USER=your_mysql_username
DB_MYSQL_PASSWORD=your_mysql_password
DB_MYSQL_DATABASE=your_database_name

# PostgreSQL (orders storage)
DB_POSTGRES_HOST=your_postgres_host_here
DB_POSTGRES_PORT=5432
DB_POSTGRES_USER=your_postgres_username
DB_POSTGRES_PASSWORD=your_postgres_password
DB_POSTGRES_DATABASE=your_database_name
